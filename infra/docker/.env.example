# ─── Local Docker Compose environment ───────────────────────────────────────
# Copy this file to infra/docker/.env and fill in values before running.
# This file is safe to commit — it contains no real secrets.

# PostgreSQL
POSTGRES_DB=hotelapp
POSTGRES_USER=hotelapp
POSTGRES_PASSWORD=localdevpassword
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (local S3 substitute)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# coturn (STUN/TURN — local WebRTC testing)
COTURN_PORT=3478
COTURN_REALM=turn.localhost
COTURN_SECRET=localturnsecret
COTURN_MIN_PORT=49152
COTURN_MAX_PORT=65535
