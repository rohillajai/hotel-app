FROM node:20-alpine AS base
RUN npm install -g pnpm@9

WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc .pnpmfile.cjs ./
COPY packages/config/package.json packages/config/
COPY packages/core/package.json packages/core/
COPY apps/signaling-server/package.json apps/signaling-server/

RUN pnpm install --no-frozen-lockfile --prod=false

COPY packages/config/ packages/config/
COPY packages/core/ packages/core/
COPY apps/signaling-server/ apps/signaling-server/

RUN pnpm --filter @hotel-app/config build
RUN pnpm --filter @hotel-app/core build
RUN pnpm --filter @hotel-app/signaling-server build

EXPOSE 3002
CMD ["node", "apps/signaling-server/dist/index.js"]
