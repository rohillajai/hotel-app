FROM node:20-alpine AS builder
RUN npm install -g pnpm@9

ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXT_PUBLIC_SIGNALING_URL=http://localhost:3002

WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/config/package.json packages/config/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/
COPY packages/api-client/package.json packages/api-client/
COPY apps/guest-pwa/package.json apps/guest-pwa/

RUN pnpm install --frozen-lockfile

COPY packages/ packages/
COPY apps/guest-pwa/ apps/guest-pwa/

RUN pnpm --filter @hotel-app/config build
RUN pnpm --filter @hotel-app/core build

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SIGNALING_URL=$NEXT_PUBLIC_SIGNALING_URL

RUN pnpm --filter @hotel-app/guest-pwa build

# ─── Production image ─────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

COPY --from=builder /app/apps/guest-pwa/.next/standalone ./
COPY --from=builder /app/apps/guest-pwa/.next/static ./apps/guest-pwa/.next/static
COPY --from=builder /app/apps/guest-pwa/public ./apps/guest-pwa/public

ENV PORT=3000
EXPOSE 3000
CMD ["node", "apps/guest-pwa/server.js"]
