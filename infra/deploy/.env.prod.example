# ─── Production environment (Single EC2 deployment) ──────────────────────────
# Copy to .env.prod and fill in your generated secrets from Step 5

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database (internal Docker network) ────────────────────────────────────────
POSTGRES_DB=hotelapp
POSTGRES_USER=hotelapp
POSTGRES_PASSWORD=<your_generated_db_password>
DATABASE_URL=postgresql://hotelapp:<your_generated_db_password>@postgres:5432/hotelapp

# ── Redis (internal Docker network) ──────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<your_generated_jwt_secret>
JWT_REFRESH_SECRET=<your_generated_jwt_refresh_secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS (for S3 + SNS in production) ─────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=<your_iam_access_key>
AWS_SECRET_ACCESS_KEY=<your_iam_secret_key>

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_KYC_BUCKET=hotel-app-prod-kyc-docs
S3_ASSETS_BUCKET=hotel-app-prod-app-assets
# No S3_ENDPOINT in production — uses real S3

# ── SNS (OTP) ────────────────────────────────────────────────────────────────
SNS_OTP_TOPIC_ARN=<create_this_in_console_if_needed>

# ── OTP ───────────────────────────────────────────────────────────────────────
# NEVER set to true in production — the config validator will refuse to start
OTP_BYPASS_ENABLED=false

# ── coturn ────────────────────────────────────────────────────────────────────
COTURN_HOST=turn.epbx.negd.in
COTURN_PORT=3478
COTURN_SECRET=<your_generated_coturn_secret>
COTURN_REALM=turn.epbx.negd.in
TURN_CREDENTIAL_TTL_SECONDS=3600

# ── VAPID (Web Push) ─────────────────────────────────────────────────────────
# Generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
VAPID_PUBLIC_KEY=<generate>
VAPID_PRIVATE_KEY=<generate>
VAPID_SUBJECT=mailto:admin@epbx.negd.in

# ── Signaling ─────────────────────────────────────────────────────────────────
SIGNALING_SERVER_URL=https://signal.epbx.negd.in
SIGNALING_INTERNAL_SECRET=<your_generated_signaling_secret>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://guest.epbx.negd.in,https://staff.epbx.negd.in,https://admin.epbx.negd.in

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
