# ─── Production environment — copy to .env.prod and fill in ────────────────
# NEVER commit .env.prod to git — it contains real secrets

# Domain
DOMAIN=epbx.negd.in

# PostgreSQL
POSTGRES_DB=hotelapp
POSTGRES_USER=hotelapp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_ACCESS_EXPIRES_IN=15m

# coturn
COTURN_HOST=13.207.8.37
COTURN_PORT=3478
COTURN_SECRET=CHANGE_ME_MIN_16_CHARS_RANDOM
COTURN_REALM=turn.epbx.negd.in
TURN_CREDENTIAL_TTL_SECONDS=3600

# Signaling
SIGNALING_SERVER_URL=https://signal.epbx.negd.in
SIGNALING_INTERNAL_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM

# AWS (for S3 + SNS)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_KYC_BUCKET=hotel-app-kyc-docs
S3_ASSETS_BUCKET=hotel-app-assets
S3_SIGNED_URL_EXPIRES_SECONDS=900
SNS_OTP_TOPIC_ARN=

# OTP
NODE_ENV=production
OTP_BYPASS_ENABLED=false
OTP_EXPIRES_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=600

# CORS — Amplify URLs (update after Amplify setup)
CORS_ORIGINS=https://guest.epbx.negd.in,https://staff.epbx.negd.in,https://admin.epbx.negd.in

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
