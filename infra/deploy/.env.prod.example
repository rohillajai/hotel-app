# ─── Production environment — fill in and rename to .env.prod ──────────────────
# NEVER commit this file with real values

NODE_ENV=production

# Database (runs inside Docker Compose — internal hostname)
POSTGRES_DB=hotelapp
POSTGRES_USER=hotelapp
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
DATABASE_URL=postgresql://hotelapp:GENERATE_STRONG_PASSWORD_HERE@postgres:5432/hotelapp

# Redis
REDIS_URL=redis://redis:6379

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=GENERATE_32_CHAR_SECRET
JWT_REFRESH_SECRET=GENERATE_32_CHAR_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS (for S3 + SNS — create an IAM user with S3+SNS permissions only)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# S3 buckets (create these manually in S3 console)
S3_KYC_BUCKET=hotel-app-kyc-docs
S3_ASSETS_BUCKET=hotel-app-assets
# No S3_ENDPOINT in production (uses real S3)

# SNS
SNS_OTP_TOPIC_ARN=arn:aws:sns:ap-south-1:YOUR_ACCOUNT_ID:hotel-otp

# OTP — MUST be false in production
OTP_BYPASS_ENABLED=false

# coturn
COTURN_HOST=15.207.160.237
COTURN_PORT=3478
COTURN_SECRET=GENERATE_COTURN_SECRET
COTURN_REALM=turn.epbx.negd.in
TURN_CREDENTIAL_TTL_SECONDS=3600

# VAPID (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@epbx.negd.in

# Signaling
SIGNALING_SERVER_URL=https://signal.epbx.negd.in
SIGNALING_INTERNAL_SECRET=GENERATE_32_CHAR_SECRET

# CORS
CORS_ORIGINS=https://guest.epbx.negd.in,https://staff.epbx.negd.in,https://admin.epbx.negd.in

# Throttle
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Port (internal — Caddy handles external HTTPS)
PORT=3001
