# ─── Production Environment — Hotel App ──────────────────────────────────────
# Copy this file to .env.prod and fill in generated secrets.
# NEVER commit .env.prod to git.

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=hotelapp
POSTGRES_USER=hotelapp
POSTGRES_PASSWORD=CHANGE_ME

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── JWT (generate: openssl rand -base64 32) ─────────────────────────────────
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ─── S3 ──────────────────────────────────────────────────────────────────────
S3_KYC_BUCKET=hotel-app-prod-kyc-docs
S3_ASSETS_BUCKET=hotel-app-prod-app-assets
S3_SIGNED_URL_EXPIRES_SECONDS=900

# ─── OTP ──────────────────────────────────────────────────────────────────────
# Set to true for testing (OTP always 123456), false for real SMS via SNS
OTP_BYPASS_ENABLED=true
OTP_BYPASS_CODE=123456
OTP_EXPIRES_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=600

# ─── coturn ───────────────────────────────────────────────────────────────────
COTURN_HOST=turn.epbx.negd.in
COTURN_PORT=3478
COTURN_SECRET=CHANGE_ME
COTURN_REALM=turn.epbx.negd.in
TURN_CREDENTIAL_TTL_SECONDS=3600

# ─── Signaling ────────────────────────────────────────────────────────────────
SIGNALING_SERVER_URL=https://signal.epbx.negd.in
SIGNALING_INTERNAL_SECRET=CHANGE_ME

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://guest.epbx.negd.in,https://staff.epbx.negd.in,https://admin.epbx.negd.in

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
