# Caddy reverse proxy — auto HTTPS via Let's Encrypt
# Handles TLS certificates automatically for all domains

api.epbx.negd.in {
    reverse_proxy api-server:3001
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
    }
}

signal.epbx.negd.in {
    reverse_proxy signaling-server:3002
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# Health check on port 80 (for AWS checks if needed)
:80 {
    respond /health "OK" 200
}
