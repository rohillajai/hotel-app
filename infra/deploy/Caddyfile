# Caddy reverse proxy — auto Let's Encrypt HTTPS for all subdomains
# All services run on this single EC2 instance

api.epbx.negd.in {
    reverse_proxy api-server:3001
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}

signal.epbx.negd.in {
    reverse_proxy signaling-server:3002
}

guest.epbx.negd.in {
    reverse_proxy guest-pwa:3000
}

staff.epbx.negd.in {
    reverse_proxy staff-pwa:3003
}

admin.epbx.negd.in {
    reverse_proxy admin-web:3004
}
