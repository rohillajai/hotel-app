FROM node:20-alpine AS base
RUN npm install -g pnpm@9

WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/config/package.json packages/config/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/
COPY packages/api-client/package.json packages/api-client/
COPY apps/admin-web/package.json apps/admin-web/

RUN pnpm install --frozen-lockfile --prod=false

COPY packages/ packages/
COPY apps/admin-web/ apps/admin-web/

RUN pnpm --filter @hotel-app/config build
RUN pnpm --filter @hotel-app/core build

ENV NEXT_PUBLIC_API_URL=https://api.epbx.negd.in
ENV NEXT_PUBLIC_SIGNALING_URL=https://signal.epbx.negd.in

RUN pnpm --filter @hotel-app/admin-web build

EXPOSE 3004
CMD ["pnpm", "--filter", "@hotel-app/admin-web", "start"]
