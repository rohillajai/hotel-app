# Allow build scripts for packages that need native compilation
enable-pre-post-scripts=true
onlyBuiltDependencies[]=@nestjs/core
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=bcrypt
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=sharp

# Workspace settings
link-workspace-packages=true
prefer-workspace-packages=true

# Hoist packages needed by Next.js and NestJS
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@nestjs/cli
