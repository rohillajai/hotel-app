# ─── Application environment variables ────────────────────────────────────────
# Copy this file to .env (gitignored) and fill in values.
# Variables marked [REQUIRED] have no default and must be set.
# Variables marked [PROD REQUIRED] must be set in production but have dev defaults.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001                          # api-server port

# ─── Database ─────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string
DATABASE_URL=postgresql://hotelapp:localdevpassword@localhost:5432/hotelapp

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Must be at least 32 characters. Use a random secret in production.
JWT_SECRET=dev-jwt-secret-change-this-in-production-min32c
JWT_REFRESH_SECRET=dev-refresh-secret-change-this-in-production-min32c
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# [PROD REQUIRED] Leave blank in local dev when using MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── S3 / MinIO ───────────────────────────────────────────────────────────────
S3_KYC_BUCKET=hotel-kyc-docs
S3_ASSETS_BUCKET=hotel-app-assets
# Set to MinIO URL for local dev; leave blank in production to use real S3
S3_ENDPOINT=http://localhost:9000
S3_SIGNED_URL_EXPIRES_SECONDS=900

# ─── AWS SNS (OTP delivery) ────────────────────────────────────────────────────
# [PROD REQUIRED]
SNS_OTP_TOPIC_ARN=

# ─── OTP ──────────────────────────────────────────────────────────────────────
# NEVER set OTP_BYPASS_ENABLED=true in production — the app will refuse to start
OTP_BYPASS_ENABLED=true
OTP_BYPASS_CODE=123456
OTP_EXPIRES_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=600

# ─── coturn / TURN ────────────────────────────────────────────────────────────
# [REQUIRED] Must match turnserver.conf static-auth-secret
COTURN_HOST=localhost
COTURN_PORT=3478
COTURN_SECRET=localturnsecret
COTURN_REALM=turn.localhost
TURN_CREDENTIAL_TTL_SECONDS=3600

# ─── Web Push / VAPID ─────────────────────────────────────────────────────────
# [PROD REQUIRED] Generate with: node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ─── Signaling server ─────────────────────────────────────────────────────────
SIGNALING_SERVER_URL=http://localhost:3002
# [PROD REQUIRED] Shared secret between api-server and signaling-server
SIGNALING_INTERNAL_SECRET=dev-internal-secret-change-this-in-production-min32c

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3004

# ─── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
